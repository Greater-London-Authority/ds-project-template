{% if project_type != 'analysis' -%}
[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
license = { text = "MIT" }
requires-python = ">={{ python_version }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
dependencies = []
{% if has_cli %}
[project.scripts]
{{ package_name }} = "{{ import_name }}.cli:app"

{% endif %}
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts   = "-v --tb=short"
{% if project_type == 'package' %}
[tool.coverage.run]
source = ["src"]

{% endif %}
{% endif -%}
[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]
{% if project_type == 'package' %}
[tool.mypy]
strict                 = true
packages               = ["{{ import_name }}"]
ignore_missing_imports = true

[tool.bumpversion]
current_version = "0.1.0"
commit = true
tag    = true

[[tool.bumpversion.files]]
filename = "pyproject.toml"
search   = 'version = "{current_version}"'
replace  = 'version = "{new_version}"'
{% endif %}
