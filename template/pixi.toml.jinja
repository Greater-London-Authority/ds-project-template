[workspace]
channels  = ["conda-forge"]
platforms = {{ platforms | tojson }}

[dependencies]
python = ">={{ python_version }}"
{% if project_type == 'analysis' and uses_gla_data %}
[pypi-dependencies]
gla-data = ">=0.4.0,<0.5"
{% endif %}
{%- if project_type != 'analysis' %}
[pypi-dependencies]
{{ import_name }} = { path = ".", editable = true }
pytest            = "*"
ruff              = "*"
{% if project_type == 'package' %}
pytest-cov      = "*"
mypy            = "*"
uv              = "*"
build           = "*"
{% endif %}

[tasks]
test   = "pytest{% if project_type == 'package' %} --cov=src --cov-report=term-missing{% endif %}"
lint   = "ruff check src tests"
format = "ruff format src tests"
{% if project_type == 'package' %}
typecheck     = "mypy"
build         = "python -m build"
publish-test  = "uv publish --publish-url https://test.pypi.org/legacy/ dist/*"
publish       = "uv publish dist/*"
add-dep       = "uv add"
{% endif %}
{% endif %}
