from pathlib import Path

from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    """Runtime configuration.

    Non-sensitive defaults live in conf/base/parameters.yml.
    Sensitive values and local overrides go in .env (gitignored).
    All settings can be overridden with environment variables prefixed
    {{ import_name | upper }}_.
    """

    data_dir:   Path = Path("data")
    output_dir: Path = Path("outputs")

    model_config = {"env_prefix": "{{ import_name | upper }}_", "env_file": ".env"}


settings = Settings()
